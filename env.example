# Copy this file to .env and fill in values from your Supabase project.
# Never put the service_role/secret key in frontend files or commit .env.
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5500
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
# Optional: comma-separated extra frontend origins, e.g. http://localhost:5500,http://127.0.0.1:5500
